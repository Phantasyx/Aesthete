{
  "name": "throughline",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "GameSession" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameSession"] }
  ],
  "routes": [
    {
      "pattern": "throughline.phantasyx.com",
      "custom_domain": true
    }
  ]
}
