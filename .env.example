# Copy to .env and fill in. .env is gitignored.
# The portfolio page does not need any of these. They configure the PHP match server only.

AESTHETE_TIMEZONE=UTC
AESTHETE_EMAIL=
# Path prefix when the PHP app is not at the host root. Leave empty for `php -S` at /.
AESTHETE_ROOT=
# Scheme and host used in account email links, such as https://play.example.com
AESTHETE_PUBLIC_ORIGIN=

# Example: mysql:host=127.0.0.1;dbname=aesthete;charset=utf8mb4
AESTHETE_DB_DSN=
AESTHETE_DB_USER=
AESTHETE_DB_PASSWORD=
# Use p2_ only if you are attaching an old database that already used that prefix.
AESTHETE_TABLE_PREFIX=aesthete_
